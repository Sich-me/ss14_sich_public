<photo:PalaroidWindow xmlns="https://spacestation14.io"
    xmlns:photo="clr-namespace:Content.Client.Photography.UI"
    xmlns:paper="clr-namespace:Content.Client.Paper.UI"
    MouseFilter="Stop" Resizable="True" MinSize="250 350"
    SetSize="350 480">

    <BoxContainer Name="ContentsRoot" Orientation="Vertical">
        <PanelContainer StyleClasses="BackgroundPanel" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="6">
            <TextureButton Name="CloseButton" StyleClasses="windowCloseButton"/>
        </PanelContainer>

        <PanelContainer Name="PaperBackground" StyleIdentifier="PaperDefaultBorder" VerticalExpand="True" HorizontalExpand="True">
            <ScrollContainer Name="ScrollingContents" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalExpand="True" VerticalExpand="True" HScrollEnabled="False">
                <PanelContainer Name="PaperContent" VerticalExpand="True" HorizontalExpand="True" MaxWidth="600">
                    <BoxContainer Orientation="Vertical" VerticalAlignment="Stretch">
                        <PanelContainer StyleClasses="PanelLight" HorizontalAlignment="Center" Margin="10">
                            <BoxContainer Orientation="Vertical" Margin="10 10 10 30">
                                <RichTextLabel Name="PolaroidImage" HorizontalAlignment="Center" MinSize="288 288"/>

                                <Control MinSize="0 10" />

                                <RichTextLabel Name="WrittenTextLabel" StyleClasses="PaperWrittenText" HorizontalAlignment="Center"/>

                                <BoxContainer Name="InputContainer">
                                    <TextEdit Name="Input" StyleClasses="PaperLineEdit" MinHeight="40" Access="Public" />
                                </BoxContainer>
                            </BoxContainer>
                        </PanelContainer>

                        <Label Name="FillStatus" StyleClasses="LabelSecondaryColor" HorizontalAlignment="Center"/>
                    </BoxContainer>
                </PanelContainer>
            </ScrollContainer>
        </PanelContainer>

        <BoxContainer Name="EditButtons" Orientation="Horizontal" HorizontalAlignment="Right" Margin="6">
            <Button Name="SaveButton" />
        </BoxContainer>
    </BoxContainer>
</photo:PalaroidWindow>
