<DefaultWindow xmlns="https://spacestation14.io"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               x:Class="Content.Client.Sich.BureaucraticComputer.UI.BureaucracyComputerWindow"
               Title="Bureaucracy Computer"
               MinSize="700 450">

    <BoxContainer Orientation="Horizontal" HorizontalExpand="True" VerticalExpand="True">

        <BoxContainer Orientation="Vertical" MinWidth="220" Margin="5 5 10 5">
            <Label Text="Доступні шаблони:" Margin="0 0 0 10" HorizontalAlignment="Center" />

            <ScrollContainer VerticalExpand="True" HorizontalExpand="True">
                <BoxContainer Name="DocumentList" Orientation="Vertical" />
            </ScrollContainer>
        </BoxContainer>

        <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True" Margin="10 5 5 5">

            <Label Text="Заповнення документу:" Margin="0 0 0 10" HorizontalAlignment="Center" />

            <ScrollContainer VerticalExpand="True" HorizontalExpand="True">
                <BoxContainer Name="DocumentFields" Orientation="Vertical" />
            </ScrollContainer>

            <Button Name="PrintButton"
                    Text="Друк"
                    HorizontalAlignment="Right"
                    Margin="0 15 0 0"
                    MinSize="120 30"
                    Disabled="True" />

        </BoxContainer>

    </BoxContainer>
</DefaultWindow>
